# ============================================================
# .gitignore - Arquivos que não devem ser versionados
# ============================================================

# Ambiente Virtual Python
.venv/
venv/
env/
ENV/

# Cache Python
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# Distribuição / Build
dist/
build/
*.egg-info/

# Arquivos de ambiente
.env
.env.local
.env.*.local

# Logs
*.log

# Sistema
.DS_Store
Thumbs.db